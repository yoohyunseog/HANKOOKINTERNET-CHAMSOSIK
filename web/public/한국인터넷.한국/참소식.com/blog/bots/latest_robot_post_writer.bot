{
  "schema": "chamsosik.bot.v1",
  "name": "latest_robot_post_writer",
  "display_name": "최신 로봇 포스팅 작성 봇",
  "description": "메인 페이지의 N/B 상한·하한 정보를 읽고, 최신 로봇 모델 검색 자료를 Ollama에 전달해 블로그 포스팅 초안을 작성한다.",
  "runner": "web/public/한국인터넷.한국/참소식.com/blog/bots/latest_robot_post_bot.py",
  "ollama": {
    "host": "http://localhost:11434",
    "model": "kimi-k2.5:cloud",
    "temperature": 0.45,
    "timeout_seconds": 180
  },
  "site": {
    "config_path": "web/public/한국인터넷.한국/참소식.com/config.json",
    "main_page_path": "web/public/한국인터넷.한국/참소식.com/index.html",
    "reference_post_path": "web/public/한국인터넷.한국/참소식.com/blog/posts/2026-06-10-latest-humanoid-robots-2026.html",
    "draft_output_dir": "web/public/한국인터넷.한국/참소식.com/blog/generated_posts"
  },
  "search": {
    "limit_per_query": 4,
    "queries": [
      "2026 latest humanoid robot model Figure 03 NEO Unitree R1 Atlas Digit",
      "recent humanoid robot model announced 2026 home factory logistics",
      "latest robot model commercial humanoid 2026 price production"
    ]
  },
  "writing_lens": {
    "budget_usd": 90,
    "time_horizon_years": 15,
    "stance": "90달러로 살 수 있는 관찰자의 거리에서, 15년 뒤 산업·가정·노동 구조까지 이어질 변화를 장기 관점으로 해석한다.",
    "must_include": [
      "최신 모델명과 발표·출시 맥락",
      "가정용·산업용·물류용으로 갈라지는 시장 구분",
      "메인 페이지에서 읽은 N/B MAX·MIN 또는 bitMaxValue·bitMinValue",
      "90달러 / 15년 관점의 투자·생활 변화 해석",
      "출처 URL 목록"
    ]
  },
  "article": {
    "language": "ko",
    "format": "markdown",
    "title_hint": "2026년 최신 휴머노이드 로봇 모델과 15년 관점의 변화",
    "target_length_words": 1400,
    "tone": "차분한 기술 블로그, 과장보다 근거 중심"
  }
}
